# ALYA ERP - VKN/TCKN otomatik mükellef sorgusu
# Seçenek A: Kurumunuzun GİB veya özel entegratör tarafından verilen yetkili endpoint'i.
# URL içinde {taxNumber} yer tutucusu zorunludur. Gizli anahtarı yalnızca gerçek .env dosyasına yazın.
GIB_LOOKUP_URL_TEMPLATE=
GIB_LOOKUP_API_KEY=
GIB_LOOKUP_API_KEY_HEADER=Authorization
GIB_LOOKUP_AUTH_SCHEME=Bearer
GIB_LOOKUP_TIMEOUT_MS=10000

# Seçenek B: mukellef.info hesabınız varsa yalnızca bu anahtarı kullanabilirsiniz.
# MUKELLEF_INFO_API_KEY=
